---
import Layout from "../../components/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { site } from "../../lib/site";

const faqs = [
  {
    q: "When should a water softener be planned during new construction?",
    a: "Before drywall goes up. The rough-in stage is when a dedicated loop, drain line, and outlet can be added without cutting into finished walls later.",
  },
  {
    q: "Does the builder or the homeowner arrange this?",
    a: `Either can. Some ${site.city} builders include a pre-plumbed loop as a standard option; if yours doesn't, we coordinate directly with your builder or GC on rough-in timing.`,
  },
  {
    q: "Can a softener be added after the home is built instead?",
    a: `Yes — most ${site.city} installs happen in existing homes. Pre-planning during construction just avoids exposed plumbing or a less convenient equipment location later.`,
  },
];
---

<Layout
  title={`New Construction Water Softener Installation, ${site.city}`}
  description={`Plan water softener rough-in for a new ${site.city} home — loop placement, drain line, and builder coordination before drywall.`}
>
  <section class="page-header">
    <div class="container">
      <Breadcrumbs items={[{ label: "Installation", href: "/installation/" }, { label: "New Construction" }]} />
      <p class="eyebrow">Rough-In Planning</p>
      <h1>New Construction Water Softener Installation, {site.city}</h1>
    </div>
  </section>

  <section class="page-header-image-section">
    <div class="container">
      <img src="https://placehold.co/1600x500?text=New+Construction+Rough-In" alt={`Water softener rough-in plumbing in a new ${site.city}, ${site.stateAbbr} home`} class="page-header-image" width="1600" height="500" loading="eager" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="brand-backlink">
        <a href="/" class="brand-link">{site.businessName}</a>
        {" "}plans and installs water softener rough-in for new-construction homes across {site.city} and {site.county}.
      </p>

      <div class="section-header">
        <p>Planning for a softener before drywall means a dedicated water loop, a floor drain or standpipe, and a nearby outlet are already in place when the unit arrives — no exposed pipe runs or retrofit cutting later. At {site.city}'s {site.gpgLow}-{site.gpgHigh} GPG reading, every new build benefits from this step regardless of final system choice.</p>
      </div>

      <div class="grid grid-3">
        <div class="card">
          <h3>Dedicated Loop</h3>
          <p>A bypass loop on the main line lets the softener install or come out for service without shutting off water to the whole house.</p>
        </div>
        <div class="card">
          <h3>Drain and Power</h3>
          <p>A floor drain or standpipe within hose reach, plus a grounded outlet, keep the eventual install code-compliant and simple.</p>
        </div>
        <div class="card">
          <h3>Equipment Location</h3>
          <p>Utility room, basement, or garage placement decided early avoids a cramped or awkward spot chosen after everything else is built.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header">
        <h2>Timeline for New Construction Installs</h2>
        <p>Rough-in coordination typically adds one site visit during the plumbing phase, then a second visit for final equipment installation once the home is move-in ready. According to {site.waterAuthority}, {site.city}'s hardness reading holds steady across new and established neighbourhoods alike — get a free quote to schedule your rough-in visit.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header center">
        <h2>New Construction Questions</h2>
        <p>Three questions come up most from {site.city} builders and homeowners.</p>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>
              {item.q}
              <svg class="faq-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6.5 8 10.5 12 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Building in {site.city}? Plan Your Rough-In</h2>
      <p>Free consultation with your builder or GC on loop, drain, and equipment placement.</p>
      <a class="btn btn-primary" href="/quote/">Get a Free Water Softener Quote in {site.city}</a>
    </div>
  </section>

  <style>
    .faq-list { max-width: 760px; margin: 24px auto 0; }
    .final-cta { text-align: center; }
    .final-cta p { max-width: 48ch; margin: 0 auto 24px; }
  </style>
</Layout>
