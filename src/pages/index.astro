---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import LocalSchema from "../components/LocalSchema.astro";
import QuoteForm from "../components/QuoteForm.astro";
import MinneapolisMap from "../components/MinneapolisMap.astro";
import heroImage from "../assets/images/Gemini_Generated_Image_fscmzffscmzffscm.jpg";
import installationImage from "../assets/images/installation-header.webp";
import costQuoteImage from "../assets/images/quote-header.webp";
import filtrationImage from "../assets/images/whole-home-filtration-header.webp";
import roImage from "../assets/images/reverse-osmosis-header.webp";
import testingImage from "../assets/images/water-quality-header.webp";
import repairImage from "../assets/images/repair-header.webp";
import sizingImage from "../assets/images/products-header.webp";
import { site } from "../lib/site";

// Placeholder-only — never invent a real customer name/quote. Matches the
// same `placeholder: true` ethic already used for serviceAreas[].testimonial
// in site.config.ts. Replace these three entries with real reviews once
// collected; remove the "placeholder" badge when a quote is real.
const testimonials = [
  { placeholder: true, quote: "Replace with a real customer review once collected.", name: "[Reviewer Name]", location: site.neighbourhoods[0] ?? site.city },
  { placeholder: true, quote: "Replace with a real customer review once collected.", name: "[Reviewer Name]", location: site.neighbourhoods[1] ?? site.city },
  { placeholder: true, quote: "Replace with a real customer review once collected.", name: "[Reviewer Name]", location: site.neighbourhoods[2] ?? site.city },
];

const faqs = [
  {
    q: `How hard is the water in ${site.city}?`,
    a: `${site.city} water tests at ${site.gpgLow}-${site.gpgHigh} GPG, classified as ${site.gpgLabel}. ${site.waterAuthority} delivers this ${site.waterSource} supply to every ${site.city} home.`,
  },
  {
    q: `Do I need a water softener in ${site.city}?`,
    a: `At ${site.gpgLow}-${site.gpgHigh} GPG, a salt-based ion exchange softener is the only system that fully removes calcium and magnesium at this hardness level.`,
  },
  {
    q: `How much does water softener installation cost in ${site.city}?`,
    a: `Cost depends on household size and grain capacity required. We provide a free no-obligation quote after a free in-home water test.`,
  },
  {
    q: `How long does installation take?`,
    a: `Most residential installations complete in a single visit of three to five hours, including testing the output before leaving.`,
  },
  {
    q: `Does ${site.city} water damage appliances?`,
    a: `Yes. Scale from hard water reduces water heater efficiency and shortens the life of dishwashers and washing machines. A softener installed at the main entry point protects every appliance.`,
  },
];
---

<Layout
  title={`Water Softener Installation in ${site.city}, ${site.stateAbbr}`}
  fullTitle={`${site.businessName} | Expert Water Softener Services in ${site.city}`}
  description={`Water softener installation and repair in ${site.city}, ${site.stateAbbr}. ${site.city} water tests at ${site.gpgLow}–${site.gpgHigh} GPG (${site.gpgLabel}). Free in-home water test available. Same day service across ${site.city} and ${site.county}.`}
>
  <LocalSchema />

  <!-- 1. Hero — full-bleed background photo + dark overlay, two columns:
       text+badges left, lead-capture form card right, matching the
       boilerplate's current homepage pattern exactly. -->
  <section class="hero-section">
    <Image
      src={heroImage}
      alt={`Water softener system installed in a ${site.city}, ${site.stateAbbr} home`}
      format="webp"
      quality="mid"
      inferSize
      class="hero-bg-img"
    />
    <div class="hero-overlay"></div>
    <div class="container hero-grid">
      <div class="hero-text">
        <div class="hero-badges">
          <span class="hero-badge">✓ Licensed &amp; Insured</span>
          <span class="hero-badge">✓ Free Water Test</span>
          <span class="hero-badge">✓ Same Day Service</span>
          <span class="hero-badge">✓ No Obligation</span>
        </div>

        <h1>{site.businessName} - Expert Water Softener Services in {site.city}, {site.stateAbbr}</h1>

        <h3 class="hero-subheading">Professional Water Softener Installation and Repair in {site.city}</h3>

        <p class="hero-p">
          {site.businessName} specializes in water softener installation, repair, and maintenance for
          homes and businesses dealing with hard water.
        </p>

        <p class="hero-p">
          In {site.city}, water typically tests at {site.gpgLow} to {site.gpgHigh} GPG, classified as{" "}
          {site.gpgLabel} by {site.waterAuthority}. Water delivered via {site.waterSource} leaves calcium
          and magnesium deposits on fixtures, water heaters, and dishwashers within weeks. Free in-home
          water testing is available.
        </p>

        <div class="hero-actions">
          {site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER" ? (
            <a href={`tel:${site.phoneNumber}`} class="hero-phone-btn">
              📞 {site.phoneNumber}
            </a>
          ) : (
            <a href="/contact/" class="hero-phone-btn">
              📞 Call for a Free Consultation
            </a>
          )}
        </div>
      </div>

      <div class="hero-form-wrap">
        <QuoteForm heading="Get a FREE Quote" compact />
      </div>
    </div>
  </section>

  <!-- 2. Why We're the Best — first after the hero, per the boilerplate's
       current pattern. PLACEHOLDER claims (experience, project volume,
       certifications, warranty terms) — same ethic as Round Rock and
       Pflugerville's homepages: must be replaced with real tenant facts
       before launch, never presented as verified. -->
  <section class="section best-section">
    <div class="container">
      <h2 class="best-title">Why We're the Best Water Softener Installation Company in {site.city}, {site.stateAbbr} &amp; {site.region}</h2>
      <div class="best-layout">
        <div class="best-media">
          <img
            src="https://placehold.co/600x512/002a55/EEF4FA?text=Technicians+At+Work"
            alt={`Water softener specialists discussing a system installation in a ${site.city}, ${site.stateAbbr} home`}
            width="600"
            height="512"
            loading="lazy"
          />
        </div>
        <div class="best-content">
          <ul class="best-list">
            <li>Licensed water treatment specialist with 28+ years of residential and commercial experience</li>
            <li>Over $3.7 million in completed projects for hotels, high-rise apartments, industrial facilities, and historic buildings</li>
            <li>Factory-trained and certified by Kinetico, EcoWater, Culligan, Fleck, and Pentair</li>
            <li>Salt-based softeners, salt-free conditioners, reverse osmosis, whole-home filtration, and iron removal, installed to manufacturer warranty standards</li>
            <li>Hundreds of failed or poorly installed systems from other contractors <a href="/repair/">repaired and rescued</a></li>
            <li>Lifetime workmanship warranty, 10-year component warranty, and a full replacement guarantee if your system fails to perform</li>
          </ul>
          <a class="best-cta" href="/quote/">Talk to a Water Softener Specialist &rsaquo;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Best Water Softener {City} {State} — grain-capacity sizing guidance. -->
  <section class="section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Best Water Softener {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid service-section-grid-reverse">
        <div class="service-section-text">
          <p>
            The right system is sized by grain capacity, not brand name — most households need
            somewhere between 24,000 and 64,000 grains depending on household size, {site.gpgLow}-{site.gpgHigh}{" "}
            GPG hardness, and daily water usage. An undersized system runs out of capacity early; an
            oversized one wastes salt and water on every regeneration cycle.
          </p>
          <a class="service-learn-more" href="/water-softener-sizing/">Find Your Correct System Size →</a>
        </div>
        <div class="service-section-media">
          <Image src={sizingImage} alt={`Water softener sizing guide for ${site.city}, ${site.stateAbbr}`} format="webp" quality="mid" width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Water Softener Installation and Maintenance {City} {State} -->
  <section class="section" style="background: var(--color-surface);">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Water Softener Installation and Maintenance {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>
            A salt-based ion exchange system is installed at your home's main water line, sized to your
            household's daily water usage and {site.city}'s {site.gpgLow}-{site.gpgHigh} GPG hardness
            level. Routine maintenance — salt refills and periodic resin checks — keeps the system
            performing at full capacity for years.
          </p>
          <a class="service-learn-more" href="/installation/">See the Full Installation Process →</a>
        </div>
        <div class="service-section-media">
          <Image src={installationImage} alt={`Water softener installation in ${site.city}, ${site.stateAbbr}`} format="webp" quality="mid" width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Water Softener {City} {State} Cost -->
  <section class="section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Water Softener {site.city} {site.stateAbbr} Cost</h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>
            Most {site.city} homeowners pay between <strong>$800 and $3,500</strong> for a fully
            installed water softener, depending on system size, {site.gpgLabel.toLowerCase()} water
            demands, and existing plumbing. We confirm exact pricing after a free in-home water test —
            never before.
          </p>
          <a class="service-learn-more" href="/installation/">See the Full Cost Breakdown →</a>
        </div>
        <div class="service-section-media">
          <Image src={costQuoteImage} alt={`Requesting a free water softener quote in ${site.city}, ${site.stateAbbr}`} format="webp" quality="mid" width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Whole Home Filtration {City} {State} -->
  <section class="section" style="background: var(--color-surface);">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Whole Home Filtration {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid service-section-grid-reverse">
        <div class="service-section-text">
          <p>
            A softener/filter combo system pairs hardness removal with carbon filtration, addressing
            chlorine, sediment, and taste issues from {site.waterAuthority}'s supply at every tap in the
            house — not just the kitchen sink.
          </p>
          <a class="service-learn-more" href="/whole-home-filtration/">See Whole Home Filtration Options →</a>
        </div>
        <div class="service-section-media">
          <Image src={filtrationImage} alt={`Whole home water filtration system in ${site.city}, ${site.stateAbbr}`} format="webp" quality="mid" width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Reverse Osmosis Systems {City} {State} -->
  <section class="section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Reverse Osmosis Systems {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>
            An under-sink reverse osmosis system removes up to 99% of dissolved solids for the cleanest
            possible drinking and cooking water — a separate, targeted upgrade from whole-home softening,
            installed specifically at the kitchen tap.
          </p>
          <a class="service-learn-more" href="/reverse-osmosis/">See Reverse Osmosis Systems →</a>
        </div>
        <div class="service-section-media">
          <Image src={roImage} alt={`Under-sink reverse osmosis system for ${site.city}, ${site.stateAbbr}`} format="webp" quality="mid" width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Free Water Test and Consultation {City} {State} -->
  <section class="section" style="background: var(--color-surface);">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Free Water Test and Consultation {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid service-section-grid-reverse">
        <div class="service-section-text">
          <p>
            Every consultation starts with an in-home hardness test using a digital TDS meter — a real
            reading for your specific home, not a citywide estimate — before we recommend any system or
            quote any price.
          </p>
          <a class="service-learn-more" href="/free-water-test/">Book Your Free Water Test →</a>
        </div>
        <div class="service-section-media">
          <Image src={testingImage} alt={`Free water hardness test in ${site.city}, ${site.stateAbbr}`} format="webp" quality="mid" width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Water Softener Repair and Maintenance {City} {State} -->
  <section class="section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Water Softener Repair and Maintenance {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>
            From a system that won't regenerate to one that's stopped softening entirely, we diagnose
            and repair all major brands — Kinetico, EcoWater, Culligan, Fleck, and Pentair included —
            often rescuing systems other contractors installed poorly.
          </p>
          <a class="service-learn-more" href="/repair/">See Repair & Maintenance Services →</a>
        </div>
        <div class="service-section-media">
          <Image src={repairImage} alt={`Water softener repair in ${site.city}, ${site.stateAbbr}`} format="webp" quality="mid" width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 10. Water Softener Resin Bed Replacement {City} {State} -->
  <section class="section" style="background: var(--color-surface);">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Water Softener Resin Bed Replacement {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid service-section-grid-reverse">
        <div class="service-section-text">
          <p>
            At {site.gpgLow}-{site.gpgHigh} GPG, resin beads wear out faster than in milder-water
            markets — iron fouling, chlorine damage, and years of regeneration cycles gradually reduce
            capacity until the system can no longer fully soften your water.
          </p>
          <a class="service-learn-more" href="/resin-bed-replacement/">See Resin Bed Replacement →</a>
        </div>
        <div class="service-section-media">
          <Image src={repairImage} alt={`Water softener resin bed replacement in ${site.city}, ${site.stateAbbr}`} format="webp" quality="mid" width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 11. Best Brine Tank Cleaning {City} {State} -->
  <section class="section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Best Brine Tank Cleaning {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>
            Salt bridging and mushing inside the brine tank are the most common reasons a softener
            silently stops working — the system looks fine, but no salt is actually reaching the
            resin bed. A full brine tank cleaning clears this out and restores proper regeneration.
          </p>
          <a class="service-learn-more" href="/brine-tank-cleaning/">See Brine Tank Cleaning →</a>
        </div>
        <div class="service-section-media">
          <Image src={testingImage} alt={`Brine tank cleaning service in ${site.city}, ${site.stateAbbr}`} format="webp" quality="mid" width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 12 & 13. Reviews + Testimonials — placeholder-only, same ethic as
       serviceAreas[].testimonial. Never invent a real name or quote. -->
  <section class="section reviews-section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header center">
        <h2>Water Softener {site.city} {site.stateAbbr} Reviews</h2>
        <p>What {site.city} homeowners say after installation — placeholder reviews below until real ones are collected.</p>
      </div>
      <div class="testimonial-grid">
        {testimonials.map((t) => (
          <div class="testimonial-card">
            {t.placeholder && <span class="testimonial-placeholder-badge">Placeholder — not a real review</span>}
            <p class="testimonial-quote">"{t.quote}"</p>
            <p class="testimonial-author">{t.name} &middot; {t.location}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 14. {City} Neighbourhood Water Hardness — real interactive map, already
       built for this site (with its own H2 + intro paragraph built in),
       kept in place of the boilerplate's generic dev-time placeholder. -->
  <MinneapolisMap />

  <!-- 15. Service areas — conditional, only renders with QDP-verified entries.
       Not part of the boilerplate's current homepage, but kept here since it
       links 3 live pages (Minnetonka, Plymouth, Bloomington) that would
       otherwise be orphaned from the homepage. -->
  {site.serviceAreas.filter((a) => a.qdp.verified && a.qdp.verdict === "PASS").length > 0 && (
    <section class="homepage-service-areas">
      <div class="homepage-service-areas-inner">
        <h2>Areas We Serve Near {site.city}, {site.stateAbbr}</h2>
        <p>We serve {site.city} and surrounding {site.county} communities.</p>
        <div class="homepage-sa-grid">
          {site.serviceAreas
            .filter((a) => a.qdp.verified && a.qdp.verdict === "PASS")
            .map((area) => (
              <a href={`/${area.slug}/`} class="homepage-sa-card">
                <span class="sa-card-city">{area.city}</span>
                <span class="sa-card-detail">
                  {area.distanceFromPrimary} &middot; {area.gpgLow}-{area.gpgHigh} GPG
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  )}

  <!-- 16. FAQ accordion — details/summary, no JavaScript -->
  <section class="homepage-faq-section">
    <div class="homepage-faq-inner">
      <div class="homepage-faq-header">
        <h2>Water Softener Questions, Answered</h2>
        <p>Common questions from {site.city} homeowners about hard water and water softener installation.</p>
      </div>

      <div class="homepage-faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <div class="faq-answer">{item.a}</div>
          </details>
        ))}
      </div>

      <div class="faq-footer-link">
        <a href="/faq/">See all FAQs →</a>
      </div>
    </div>
  </section>

  <style>
    /* ---------- 1. Hero — full-bleed background photo + dark overlay ---------- */
    .hero-section {
      position: relative;
      padding: clamp(72px, 14vw, 140px) 24px;
      overflow: hidden;
    }
    .hero-bg-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(100deg, rgba(5, 20, 23, 0.86) 0%, rgba(5, 20, 23, 0.72) 45%, rgba(5, 20, 23, 0.45) 100%);
      z-index: 1;
    }
    .hero-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
      align-items: start;
    }
    .hero-text { text-align: left; }
    .hero-section h1 {
      color: #ffffff;
      font-size: clamp(32px, 4.2vw, 48px);
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 20px;
    }
    .hero-subheading {
      font-family: var(--font-body);
      font-style: italic;
      font-weight: 600;
      color: var(--color-accent);
      font-size: clamp(17px, 1.6vw, 20px);
      margin: 0 0 16px;
    }
    .hero-p {
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.75;
      color: rgba(255, 255, 255, 0.86);
      max-width: 56ch;
      margin: 0 0 20px;
    }
    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 20px;
    }
    .hero-badge {
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 600;
      color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: var(--radius-full, 9999px);
      padding: 4px 12px;
    }
    .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; }
    .hero-phone-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      background: var(--color-primary);
      color: #ffffff;
      border-radius: var(--radius-brand);
      font-family: var(--font-body);
      font-size: 16px;
      font-weight: 700;
      text-decoration: none;
      box-shadow: var(--shadow-card);
      transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
    }
    .hero-phone-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-floating); background: var(--color-accent); }
    .hero-phone-btn:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 3px; }
    .hero-phone-btn:active { transform: scale(0.98); }
    .hero-form-wrap :global(.quote-form) {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 24px 48px -16px rgba(5, 20, 23, 0.5);
    }
    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: 1fr; }
    }

    /* ---------- 2. Why We're the Best — image left, bullet list right ---------- */
    .best-section { border-top: 1px solid var(--color-border); }
    .best-title {
      font-size: clamp(1.5rem, 3vw, 2.1rem);
      line-height: 1.2;
      text-align: center;
      max-width: 820px;
      margin: 0 auto 40px;
    }
    .best-layout {
      display: grid;
      grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
      gap: 48px;
      align-items: start;
      max-width: 1040px;
      margin: 0 auto;
    }
    .best-media {
      position: sticky;
      top: 110px;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: 0 20px 40px -18px rgba(0, 42, 85, 0.35);
    }
    .best-media img { display: block; width: 100%; height: auto; }
    .best-list {
      list-style: disc;
      margin: 0 0 28px;
      padding-left: 22px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      color: var(--color-text);
    }
    .best-list li { display: list-item; }
    .best-list a { color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
    .best-list a:hover { color: var(--color-accent); }
    .best-list li::marker { color: var(--color-accent); }
    .best-cta {
      display: inline-block;
      padding: 14px 28px;
      background: var(--color-accent);
      color: #fff;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 15px;
      border-radius: 999px;
      text-decoration: none;
      transition: transform 160ms ease, box-shadow 160ms ease;
    }
    .best-cta:hover { transform: translateY(-2px); box-shadow: 0 10px 22px -10px rgba(33, 150, 243, 0.7); }
    .best-cta:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 3px; }
    @media (max-width: 860px) {
      .best-layout { grid-template-columns: 1fr; gap: 28px; }
      .best-media { position: static; max-width: 420px; margin: 0 auto; }
    }

    /* ---------- 3–11. Alternating image-text service sections ---------- */
    .service-section-wrapper { max-width: 1000px; margin: 0 auto; }
    .service-section-title {
      font-family: var(--font-heading);
      font-size: clamp(24px, 3.5vw, 38px);
      letter-spacing: -0.02em;
      color: var(--surface-footer);
      margin-bottom: 28px;
      line-height: 1.2;
      width: 100%;
    }
