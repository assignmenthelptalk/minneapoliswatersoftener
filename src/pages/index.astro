---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import LocalSchema from "../components/LocalSchema.astro";
import MinneapolisMap from "../components/MinneapolisMap.astro";
import QuoteForm from "../components/QuoteForm.astro";
import heroImage from "../assets/images/Gemini_Generated_Image_fscmzffscmzffscm.jpg";
import installationImage from "../assets/images/installation-header.webp";
import bestSoftenerImage from "../assets/images/products-header.webp";
import costQuoteImage from "../assets/images/quote-header.webp";
import filtrationImage from "../assets/images/whole-home-filtration-header.webp";
import roImage from "../assets/images/reverse-osmosis-header.webp";
import testingImage from "../assets/images/water-quality-header.webp";
import repairImage from "../assets/images/repair-header.webp";
import { site } from "../lib/site";

const faqs = [
  {
    q: `How hard is the water in ${site.city}?`,
    a: `${site.city} water tests at ${site.gpgLow}-${site.gpgHigh} GPG, classified as ${site.gpgLabel}. ${site.waterAuthority} delivers this ${site.waterSource} supply to every ${site.city} home.`,
  },
  {
    q: `Do I need a water softener in ${site.city}?`,
    a: `At ${site.gpgLow}-${site.gpgHigh} GPG, a salt-based ion exchange softener is the only system that fully removes calcium and magnesium at this hardness level.`,
  },
  {
    q: `How much does water softener installation cost in ${site.city}?`,
    a: `Cost depends on household size and grain capacity required. We provide a free no-obligation quote after a free in-home water test.`,
  },
  {
    q: `How long does installation take?`,
    a: `Most residential installations complete in a single visit of three to five hours, including testing the output before leaving.`,
  },
  {
    q: `Does ${site.city} water damage appliances?`,
    a: `Yes. Scale from hard water reduces water heater efficiency and shortens the life of dishwashers and washing machines. A softener installed at the main entry point protects every appliance.`,
  },
];
---

<Layout
  title={`Water Softener Installation in ${site.city}, ${site.stateAbbr}`}
  description={`Water softener installation and repair in ${site.city}, ${site.stateAbbr}. ${site.city} water tests at ${site.gpgLow}–${site.gpgHigh} GPG — ${site.gpgLabel}. Free in-home water test available. Same day service across ${site.city} and ${site.county}.`}
>
  <LocalSchema />

  <!-- 1. HERO — full-bleed background image, content left, quote form right.
       Structure and style ported from watersoftenerhendersonnv.com's homepage,
       keeping Minneapolis's own navy/blue brand colors (not Henderson's teal/orange). -->
  <section class="hero-section">

    <!-- Full-bleed background image -->
    <Image
      src={heroImage}
      alt={`Professional water softener installation and service in ${site.city}, ${site.stateAbbr}`}
      format="webp"
      quality="mid"
      inferSize
      class="hero-bg"
    />

    <!-- Dark overlay -->
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="hero-inner">

      <!-- Left: content -->
      <div class="hero-content">

        <!-- Trust badges row — top of content -->
        <div class="hero-badges">
          <span class="hero-badge">✓ Licensed &amp; Insured</span>
          <span class="hero-badge">✓ Free Water Test</span>
          <span class="hero-badge">✓ Same Day Service</span>
          <span class="hero-badge">✓ No Obligation</span>
        </div>

        <!-- H1 — brand entity -->
        <h1 class="hero-h1">
          {site.businessName} - Premier Water Softener Installation in {site.city}, {site.stateAbbr}
        </h1>

        <!-- H3 italic subheading -->
        <h3 class="hero-sub">
          Professional Water Softener Installation and Repair in {site.city}
        </h3>

        <!-- Two body paragraphs -->
        <p class="hero-p">
          In {site.city}, water typically tests at {site.gpgLow} to {site.gpgHigh} GPG, classified as
          {site.gpgLabel} by {site.waterAuthority}. Water delivered via {site.waterSource} leaves
          calcium and magnesium deposits on fixtures, water heaters, and dishwashers within weeks.
          Free in-home water testing is available.
        </p>

        <p class="hero-p">
          {site.businessName} specializes in water softener installation, repair, and maintenance
          for homes and businesses dealing with hard water.
        </p>

        <!-- Phone CTA button — bottom of content -->
        {site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER" ? (
          <a href={`tel:${site.phoneNumber}`} class="hero-phone-btn">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 1.5h2.2l1 3-1.6 1.2a9 9 0 0 0 4.2 4.2l1.2-1.6 3 1v2.2c0 .8-.7 1.4-1.4 1.3C7 12.4 3.6 9 3.2 3.9c-.1-.7.5-1.4 1.3-1.4Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
            </svg>
            {site.phoneNumber}
          </a>
        ) : (
          <a href="/contact/" class="hero-phone-btn">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 1.5h2.2l1 3-1.6 1.2a9 9 0 0 0 4.2 4.2l1.2-1.6 3 1v2.2c0 .8-.7 1.4-1.4 1.3C7 12.4 3.6 9 3.2 3.9c-.1-.7.5-1.4 1.3-1.4Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
            </svg>
            Call for a Free Consultation
          </a>
        )}

      </div>

      <!-- Right: quote form card -->
      <div class="hero-form-card">
        <QuoteForm heading="Get Free Estimates" />
      </div>

    </div>
  </section>

  <!-- 2. TEN H2 SERVICE SECTIONS — keyword-exact headings, ported from Henderson's
       homepage structure, rewritten with Minneapolis's own verified facts. -->

  <section class="service-section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Water Softener Installation and Maintenance {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>At {site.gpgLow}–{site.gpgHigh} GPG, {site.waterAuthority} classifies {site.city} water as {site.gpgLabel} — hard enough that a salt-based ion exchange softener is the system that actually removes the calcium and magnesium, rather than just conditioning it. We size every installation to your household's water usage and {site.city}'s confirmed GPG reading, not a statewide estimate, and most installations complete in a single visit. Free water test included with every consultation.</p>
          <a class="service-learn-more" href="/installation/">See Water Softener Installation Details →</a>
        </div>
        <div class="service-section-media">
          <Image
            src={installationImage}
            alt={`Water softener system installed in a ${site.city}, ${site.stateAbbr} home`}
            format="webp"
            quality="mid"
            width={600}
            height={400}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Best Water Softener {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid service-section-grid-reverse">
        <div class="service-section-text">
          <p>At {site.gpgLow}–{site.gpgHigh} GPG, the best fit for a {site.city} home is a salt-based ion exchange system sized to household size — a 24,000-grain system handles 1 to 2 people, up to 48,000–64,000 grains for larger households. We recommend systems rated specifically for {site.city}'s water, selected and sized for your home rather than a one-size-fits-all pick.</p>
          <a class="service-learn-more" href="/products/">See Recommended Products →</a>
        </div>
        <div class="service-section-media">
          <Image
            src={bestSoftenerImage}
            alt={`Recommended water softener system for ${site.city}, ${site.stateAbbr} ${site.gpgLow}-${site.gpgHigh} GPG water`}
            format="webp"
            quality="mid"
            width={600}
            height={400}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Water Softener {site.city} {site.stateAbbr} Cost</h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>Most {site.city} homeowners pay between $800 and $3,500 for a fully installed water softener, depending on system size, water hardness, and existing plumbing. At {site.gpgLow}–{site.gpgHigh} GPG, an undersized system leaves hardness minerals in the water, while an oversized one wastes salt and water — we size every system to your actual usage. Free no-obligation quote included with every free water test. No surprise charges.</p>
          <a class="service-learn-more" href="/installation/">See Installation Pricing →</a>
        </div>
        <div class="service-section-media">
          <Image
            src={costQuoteImage}
            alt={`Requesting a free water softener quote in ${site.city}, ${site.stateAbbr}`}
            format="webp"
            quality="mid"
            width={600}
            height={400}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Whole Home Filtration {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid service-section-grid-reverse">
        <div class="service-section-text">
          <p>A softener removes hardness minerals, but a whole-home filter goes further, addressing chlorine, sediment, and other contaminants from {site.waterAuthority}'s supply. A softener-plus-filter combo gives {site.city} homes complete water treatment from a single installation point — one system, one maintenance schedule, one entry point into your home's plumbing.</p>
          <a class="service-learn-more" href="/whole-home-filtration/">See Combo Systems →</a>
        </div>
        <div class="service-section-media">
          <Image
            src={filtrationImage}
            alt={`Whole home water filtration system in ${site.city}, ${site.stateAbbr}`}
            format="webp"
            quality="mid"
            width={600}
            height={400}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Reverse Osmosis Systems {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>Reverse osmosis removes up to 99 percent of dissolved solids from tap water, including residual minerals, nitrates, and chlorine byproducts that pass through standard filtration. An under-sink RO system gives {site.city} homes a dedicated purified drinking-water tap, and works best paired with a whole-home softener that protects the RO membrane from scale damage at {site.gpgLow}–{site.gpgHigh} GPG.</p>
          <a class="service-learn-more" href="/reverse-osmosis/">See RO Systems →</a>
        </div>
        <div class="service-section-media">
          <Image
            src={roImage}
            alt={`Under-sink reverse osmosis system for ${site.city}, ${site.stateAbbr}`}
            format="webp"
            quality="mid"
            width={600}
            height={400}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Free Water Test and Consultation {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid service-section-grid-reverse">
        <div class="service-section-text">
          <p>Every {site.city} consultation includes a free in-home water hardness test. Results take minutes and confirm your exact GPG reading at your own tap — {site.waterAuthority}'s {site.gpgLow}–{site.gpgHigh} GPG figure is a citywide average, and your specific reading is what we use to size the right system for your household. No obligation to proceed. Same day availability across {site.city} and {site.county}.</p>
          <a class="service-learn-more" href="/free-water-test/">Get a Free Water Test →</a>
        </div>
        <div class="service-section-media">
          <Image
            src={testingImage}
            alt={`Testing tap water hardness in ${site.city}, ${site.stateAbbr}`}
            format="webp"
            quality="mid"
            width={600}
            height={400}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Water Softener Repair and Maintenance {site.city} {site.stateAbbr}</h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>{site.city} water softeners running on {site.gpgLow}–{site.gpgHigh} GPG water need periodic maintenance to stay efficient. Common issues include resin bead exhaustion, salt bridges in the brine tank, faulty control valves, and regeneration cycle failures — a softener that stops regenerating passes hard water through unchanged. We diagnose and repair all major water softener brands, such as Kinetico, Culligan, and EcoWater, across {site.city} and {site.county}. Free diagnostic included with every repair call.</p>
          <a class="service-learn-more" href="/repair/">See Water Softener Repair Details →</a>
        </div>
        <div class="service-section-media">
          <Image
            src={repairImage}
            alt={`Water softener repair and diagnostic service in ${site.city}, ${site.stateAbbr}`}
            format="webp"
            quality="mid"
            width={600}
            height={400}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="service-section-inner">
      <h2>Water Softener Resin Bed Replacement {site.city} {site.stateAbbr}</h2>
      <p>{site.city}'s {site.gpgLow}–{site.gpgHigh} GPG water forces a softener's resin bed to regenerate more often than in a softer-water market, wearing the resin down faster than its typical 10 to 15 year lifespan. Signs of a failed resin bed include hard water returning despite regeneration, resin beads appearing in faucets, and rising salt usage without softer water. Resin-only replacement usually costs less than a full system swap, and we include a free diagnostic with every quote.</p>
      <a class="service-learn-more" href="/resin-bed-replacement/">See Resin Bed Replacement Details →</a>
    </div>
  </section>

  <section class="service-section">
    <div class="service-section-inner">
      <h2>Best Brine Tank Cleaning {site.city} {site.stateAbbr}</h2>
      <p>At {site.gpgLow}–{site.gpgHigh} GPG, {site.city} softeners regenerate often enough that brine tank salt can bridge into a hardened crust or mush into sludge faster than in a moderate-hardness market. A bridged or clogged tank stops drawing brine, letting hard water pass through untouched. Cleaning restores proper salt draw and protects the resin bed from starvation — free diagnostic with every quote.</p>
      <a class="service-learn-more" href="/brine-tank-cleaning/">See Brine Tank Cleaning Details →</a>
    </div>
  </section>

  <section class="service-section">
    <div class="service-section-inner">
      <h2>Water Softener {site.city} {site.stateAbbr} Reviews</h2>
      <p>{site.city} homeowners choosing a water softener installer want proof the system works and the service is reliable. We collect reviews from {site.city} customers after every installation and repair call, covering system performance, installation experience, and the before-and-after difference in water quality at {site.gpgLow}–{site.gpgHigh} GPG.</p>
      <a class="service-learn-more" href={site.googleBusinessUrl || "/quote/"}>See Google Reviews →</a>
    </div>
  </section>

  <!-- 3. Neighbourhood hardness map — intro paragraph + map, see PROVISION.md Step 5b -->
  <section class="service-section">
    <div class="service-section-inner">
      <p>{site.city}'s {site.gpgLow}-{site.gpgHigh} GPG ({site.gpgLabel}) reading holds steady across roughly {site.population} residents and every neighbourhood we serve, such as {site.neighbourhoods.join(", ")}, at ZIP codes {site.zipCodes.join(", ")}. See your specific neighbourhood on the interactive map below.</p>
    </div>
  </section>
  <MinneapolisMap />

  <!-- 4. Service areas — conditional, only renders with QDP-verified entries -->
  {site.serviceAreas.filter((a) => a.qdp.verified && a.qdp.verdict === "PASS").length > 0 && (
    <section class="homepage-service-areas">
      <div class="homepage-service-areas-inner">
        <h2>Areas We Serve Near {site.city}, {site.stateAbbr}</h2>
        <p>We serve {site.city} and surrounding {site.county} communities.</p>
        <div class="homepage-sa-grid">
          {site.serviceAreas
            .filter((a) => a.qdp.verified && a.qdp.verdict === "PASS")
            .map((area) => (
              <a href={`/${area.slug}/`} class="homepage-sa-card">
                <span class="sa-card-city">{area.city}</span>
                <span class="sa-card-detail">
                  {area.distanceFromPrimary} &middot; {area.gpgLow}-{area.gpgHigh} GPG
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  )}

  <!-- 5. FAQ accordion — details/summary, no JavaScript -->
  <section class="homepage-faq-section">
    <div class="homepage-faq-inner">
      <div class="homepage-faq-header">
        <h2>Water Softener Questions, Answered</h2>
        <p>These are the most common questions {site.city} homeowners ask about hard water and water
           softener installation, drawn from {site.waterAuthority}'s own hardness data.</p>
      </div>

      <div class="homepage-faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <div class="faq-answer">{item.a}</div>
          </details>
        ))}
      </div>

      <div class="faq-footer-link">
        <a href="/faq/">See all FAQs →</a>
      </div>
    </div>
  </section>

  <!-- 6. Slim CTA bar -->
  <section class="homepage-cta-bar">
    <div class="homepage-cta-bar-inner">
      <p>
        {site.city} water tests at {site.gpgLow}–{site.gpgHigh} GPG. Free in-home water test available.
        Same day across {site.city} and {site.county}.
      </p>
      <a href="/quote/" class="cta-bar-btn">Book a Free Water Test →</a>
    </div>
  </section>

  <style>
    /* ---------- Hero: full-bleed background image, split layout ---------- */
    .hero-section {
      position: relative;
      min-height: 640px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    /* Background image — real photo via astro:assets, absolutely
       positioned to fill the section exactly like a CSS background. */
    .hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }

    /* Dark overlay over the photo — Minneapolis navy, not Henderson's teal. */
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        rgba(0, 42, 85, 0.82) 0%,
        rgba(0, 42, 85, 0.75) 50%,
        rgba(0, 42, 85, 0.45) 100%
      );
      z-index: 1;
    }

    /* Inner layout — two columns */
    .hero-inner {
      position: relative;
      z-index: 2;
      max-width: 1100px;
      margin: 0 auto;
      padding: 80px 24px;
      display: grid;
      grid-template-columns: 1fr 400px;
      gap: 48px;
      align-items: center;
      width: 100%;
    }

    /* Trust badges */
    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 20px;
    }
    .hero-badge {
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
      background: rgba(255, 255, 255, 0.10);
      border: 1px solid rgba(255, 255, 255, 0.20);
      border-radius: var(--radius-sm);
      padding: 4px 10px;
      letter-spacing: 0.02em;
    }

    /* H1 */
    .hero-h1 {
      font-family: var(--font-heading);
      font-size: clamp(32px, 5vw, 54px);
      color: #ffffff;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }

    /* H3 italic subheading */
    .hero-sub {
      font-family: var(--font-body);
      font-size: clamp(15px, 2vw, 18px);
      font-style: italic;
      font-weight: 600;
      color: var(--color-accent);
      margin-bottom: 24px;
      line-height: 1.4;
    }

    /* Body paragraphs */
    .hero-p {
      font-family: var(--font-body);
      font-size: 15px;
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.75;
      margin-bottom: 16px;
      max-width: 540px;
    }

    /* Phone CTA button */
    .hero-phone-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-top: 12px;
      padding: 14px 28px;
      background: var(--color-accent);
      color: #ffffff;
      border-radius: var(--radius-md);
      font-family: var(--font-body);
      font-size: 18px;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 2px 12px rgba(33, 150, 243, 0.35);
      transition: background-color 150ms ease,
                  transform 150ms ease,
                  box-shadow 150ms ease;
    }
    .hero-phone-btn:hover {
      background: var(--color-accent-dark);
      transform: translateY(-2px);
      box-shadow: 0 4px 20px rgba(33, 150, 243, 0.45);
    }
    .hero-phone-btn:focus-visible {
      outline: 3px solid var(--color-accent);
      outline-offset: 2px;
    }
    .hero-phone-btn:active { transform: scale(0.98); }

    /* Quote form card — right side. The card chrome (background, shadow,
       padding) lives on QuoteForm's own .card styles, so this wrapper
       only needs to size the grid column, not add a second card shell. */
    .hero-form-card {
      align-self: start;
    }

    /* Mobile — stack vertically */
    @media (max-width: 900px) {
      .hero-inner {
        grid-template-columns: 1fr;
        padding: 48px 20px;
        gap: 32px;
      }
      .hero-overlay {
        background: rgba(0, 42, 85, 0.80);
      }
    }

    /* ---------- Ten H2 service sections ---------- */
    .service-section { padding: 64px 24px; background: var(--surface-base); }
    .service-section:nth-of-type(even) { background: var(--surface-elevated); }
    .service-section-inner { max-width: 860px; margin: 0 auto; }
    .service-section-inner h2 {
      font-family: var(--font-heading);
      font-size: clamp(22px, 3vw, 34px);
      color: var(--surface-footer);
      letter-spacing: -0.02em;
      margin-bottom: 16px;
    }
    .service-section-inner p {
      font-family: var(--font-body);
      font-size: 15px;
      color: var(--color-text-muted);
      line-height: 1.75;
      margin-bottom: 16px;
    }
    .service-learn-more {
      display: inline-block;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 13px;
      color: var(--color-accent);
      text-decoration: none;
    }
    .service-learn-more:hover { text-decoration: underline; }
    .service-learn-more:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }

    /* Seven of the ten sections (Installation, Best Softener, Cost, Whole
       Home, Reverse Osmosis, Free Water Test, Repair) pair their copy with
       a photo in a two-column grid, with the H2 sitting above both columns
       as a full-width section title. .service-section-wrapper takes over
       the max-width/centering role .service-section-inner plays for the
       other three plain sections — its own padding is intentionally
       omitted since the outer .service-section already sets 64px/24px
       padding; adding more here would double up and break the vertical
       rhythm shared with the other three sections. */
    .service-section-wrapper {
      max-width: 1000px;
      margin: 0 auto;
    }
    .service-section-title {
      font-family: var(--font-heading);
      font-size: clamp(24px, 3.5vw, 38px);
      letter-spacing: -0.02em;
      color: var(--surface-footer);
      margin-bottom: 28px;
      line-height: 1.2;
      width: 100%;
    }
    /* Text always comes first in the DOM (before the image, for reading
       order and accessibility) — the "-reverse" modifier only flips the
       VISUAL order via CSS `order`, giving the text-left/image-left
       alternation without reordering the markup. */
    .service-section-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
    }
    .service-section-text { order: 1; }
    .service-section-media { order: 2; }
    .service-section-grid-reverse .service-section-text { order: 2; }
    .service-section-grid-reverse .service-section-media { order: 1; }
    .service-section-media img {
      display: block;
