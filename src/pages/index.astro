---
import Layout from "../components/Layout.astro";
import LocalSchema from "../components/LocalSchema.astro";
import { site } from "../lib/site";

const services = [
  { emoji: "💧", name: "Water Quality Testing", href: "/water-quality/", detail: `Free in-home hardness test, for example a same-week ${site.city} appointment.` },
  { emoji: "🧪", name: "Hard Water Treatment", href: "/hard-water/", detail: `Stop scale buildup on fixtures and appliances such as water heaters and dishwashers.` },
  { emoji: "🔧", name: "Installation", href: "/installation/", detail: `Sized correctly for ${site.city}'s ${site.gpgLow}-${site.gpgHigh} GPG water.` },
  { emoji: "🛠️", name: "Repair", href: "/repair/", detail: `Diagnosis and repair for all major softener brands like Kinetico and Culligan.` },
  { emoji: "⚖️", name: "System Comparison", href: "/comparison/", detail: `Salt-based vs salt-free, sized for your household.` },
];

const faqs = [
  {
    q: `How hard is the water in ${site.city}?`,
    a: `${site.city} water tests at ${site.gpgLow}-${site.gpgHigh} GPG, classified as ${site.gpgLabel}. ${site.waterAuthority} delivers this ${site.waterSource} supply to every ${site.city} home.`,
  },
  {
    q: `Do I need a water softener in ${site.city}?`,
    a: `At ${site.gpgLow}-${site.gpgHigh} GPG, a salt-based ion exchange softener is the only system that fully removes calcium and magnesium at this hardness level.`,
  },
  {
    q: `How much does water softener installation cost in ${site.city}?`,
    a: `Cost depends on household size and grain capacity required. We provide a free no-obligation quote after a free in-home water test.`,
  },
  {
    q: `How long does installation take?`,
    a: `Most residential installations complete in a single visit of three to five hours, including testing the output before leaving.`,
  },
  {
    q: `Does ${site.city} water damage appliances?`,
    a: `Yes. Scale from hard water reduces water heater efficiency and shortens the life of dishwashers and washing machines. A softener installed at the main entry point protects every appliance.`,
  },
];
---

<Layout title={`${site.city} Water Softeners — ${site.stateAbbr}`}>
  <LocalSchema />

  <!-- 1. Hero — gradient background, no image, no form -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-badges">
        <span class="hero-badge">✓ Licensed &amp; Insured</span>
        <span class="hero-badge">✓ Free Water Test</span>
        <span class="hero-badge">✓ Same Day Service</span>
        <span class="hero-badge">✓ No Obligation</span>
      </div>

      <h1>{site.city} Water Softeners — {site.stateAbbr}</h1>

      <p class="hero-p">
        {site.city}, {site.stateAbbr} water tests at {site.gpgLow}-{site.gpgHigh} GPG, classified as {site.gpgLabel}.
        {site.waterAuthority} delivers this {site.waterSource} supply to every {site.city} home, leaving calcium
        and magnesium deposits on fixtures, appliances, and plumbing within weeks. A properly sized salt-based
        water softener removes these minerals completely. Free in-home water test available.
      </p>

      <div class="hero-actions">
        {site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER" ? (
          <a href={`tel:${site.phoneNumber}`} class="hero-phone-btn">
            📞 {site.phoneNumber}
          </a>
        ) : (
          <a href="/contact/" class="hero-phone-btn">
            📞 Call for a Free Consultation
          </a>
        )}
        <a href="/contact/" class="hero-secondary-btn">Get a Free Quote →</a>
      </div>
    </div>
  </section>

  <!-- 2. Services grid — 5 tiles -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <h2>Water Softener Services in {site.city}, {site.stateAbbr}</h2>
        <p>We handle five core services for {site.city} homes, from a free hardness test through installation and ongoing repair.</p>
      </div>
      <div class="grid grid-services">
        {services.map((s) => (
          <a class="service-tile" href={s.href}>
            <span class="service-tile-emoji" aria-hidden="true">{s.emoji}</span>
            <h3>{s.name}</h3>
            <p>{s.detail}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. GPG data — two column, text left, stat right -->
  <section class="section" style="background: var(--color-surface);">
    <div class="container gpg-data-grid">
      <div>
        <h2>{site.city}'s Water Hardness Reading</h2>
        <p>
          According to {site.waterAuthority}, {site.city} water holds steady at {site.gpgLow}-{site.gpgHigh} GPG
          citywide, classified as {site.gpgLabel} by the Water Quality Association. This reading comes from
          {site.waterSource}, and it stays consistent across every neighbourhood {site.city} homes sit in,
          including {site.neighbourhoods.slice(0, 3).join(", ")}. See the full {site.city} water quality report
          for the ZIP-by-ZIP breakdown.
        </p>
      </div>
      <div class="gpg-stat-card">
        <span class="gpg-stat-number">{site.gpgLow}-{site.gpgHigh}</span>
        <span class="gpg-stat-label">GPG &middot; {site.gpgLabel}</span>
      </div>
    </div>
  </section>

  <!-- 4. Alternating image-text 1 of 4 — text left, image right -->
  <section class="section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Water Softener Installation in {site.city}, {site.stateAbbr}</h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>
            We size every installation to {site.city}'s {site.gpgLow}-{site.gpgHigh} GPG reading and your
            household's water usage, not a statewide estimate. Most installations complete in a single visit,
            and a free water test is included with every consultation. Get a free quote to see exact pricing
            for your household size.
          </p>
          <a class="service-learn-more" href="/installation/">Water Softener Installation in {site.city}: Process, Timeline &amp; Cost</a>
        </div>
        <div class="service-section-media">
          <img src="https://placehold.co/600x400/1A3A5C/ffffff?text=Installation" alt={`Water softener installation in ${site.city}, ${site.stateAbbr}`} width="600" height="400" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Alternating image-text 2 of 4 — image left, text right -->
  <section class="section" style="background: var(--color-surface);">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Hard Water Effects in {site.city}, {site.stateAbbr}</h2>
      <div class="service-section-grid service-section-grid-reverse">
        <div class="service-section-text">
          <p>
            At {site.gpgLow}-{site.gpgHigh} GPG, hard water leaves calcium and magnesium deposits on fixtures,
            inside appliances, and inside supply lines within weeks, per {site.waterAuthority}'s own hardness
            reading. A whole-home softener stops this at the source instead of treating the symptoms one
            fixture at a time — explore the full list of effects below.
          </p>
          <a class="service-learn-more" href="/hard-water/">Hard Water Effects in {site.city}: What It Does to Your Home</a>
        </div>
        <div class="service-section-media">
          <img src="https://placehold.co/600x400/0F2340/ffffff?text=Hard+Water" alt={`Hard water effects in ${site.city}, ${site.stateAbbr}`} width="600" height="400" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. CityMap placeholder — see PROVISION.md Step 5b -->
  <!-- CityMap component — see PROVISION.md Step 5b -->
  {import.meta.env.DEV && (
    <div class="map-placeholder">
      City neighbourhood map goes here. Build {site.city}Map.astro per PROVISION.md Step 5b
    </div>
  )}

  <!-- 7. Service areas — conditional, only renders with QDP-verified entries -->
  {site.serviceAreas.filter((a) => a.qdp.verified && a.qdp.verdict === "PASS").length > 0 && (
    <section class="homepage-service-areas">
      <div class="homepage-service-areas-inner">
        <h2>Areas We Serve Near {site.city}, {site.stateAbbr}</h2>
        <p>We serve {site.city} and surrounding {site.county} communities.</p>
        <div class="homepage-sa-grid">
          {site.serviceAreas
            .filter((a) => a.qdp.verified && a.qdp.verdict === "PASS")
            .map((area) => (
              <a href={`/${area.slug}/`} class="homepage-sa-card">
                <span class="sa-card-city">{area.city}</span>
                <span class="sa-card-detail">
                  {area.distanceFromPrimary} &middot; {area.gpgLow}-{area.gpgHigh} GPG
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  )}

  <!-- 8. Why Choose Us — bullet list, no cards -->
  <section class="section" style="background: var(--color-surface);">
    <div class="container why-choose-us">
      <h2>Why {site.city} Homeowners Choose Us</h2>
      <p>Five reasons {site.city} homeowners pick us over a generic national installer:</p>
      <ul class="why-choose-list">
        <li>Sized specifically for {site.city}'s {site.gpgLow}-{site.gpgHigh} GPG water, not a generic estimate</li>
        <li>Free in-home water hardness test with every consultation</li>
        <li>Honest recommendation — repair, replace, or install, based on your actual system and water</li>
        <li>No obligation, no sales pressure, pricing confirmed before any work begins</li>
        <li>Local service across {site.city} and {site.county}</li>
      </ul>
      <p>Get a free quote today to see exactly what a properly sized system costs for your home.</p>
    </div>
  </section>

  <!-- 9. FAQ accordion — details/summary, no JavaScript -->
  <section class="homepage-faq-section">
    <div class="homepage-faq-inner">
      <div class="homepage-faq-header">
        <h2>Water Softener Questions, Answered</h2>
        <p>Common questions from {site.city} homeowners about hard water and water softener installation.</p>
      </div>

      <div class="homepage-faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <div class="faq-answer">{item.a}</div>
          </details>
        ))}
      </div>

      <div class="faq-footer-link">
        <a href="/faq/">Water Softener FAQs for {site.city} Homeowners</a>
      </div>
    </div>
  </section>

  <!-- 10. Slim CTA bar -->
  <section class="homepage-cta-bar">
    <div class="homepage-cta-bar-inner">
      <p>
        As of {site.city}'s most recent water authority reading, {site.city} water tests at {site.gpgLow}-{site.gpgHigh} GPG.
        Free in-home water test available.
      </p>
      <a href="/contact/" class="cta-bar-btn">Get a Free Quote →</a>
    </div>
  </section>

  <style>
    /* ---------- 1. Hero ---------- */
    .hero-section {
      background: linear-gradient(135deg, #1A3A5C 0%, #0F2340 100%);
      padding: clamp(56px, 9vw, 100px) 24px;
      color: #ffffff;
      text-align: center;
    }
    .hero-inner { max-width: 760px; margin: 0 auto; }
    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-bottom: 20px;
    }
    .hero-badge {
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
      background: rgba(255, 255, 255, 0.10);
      border: 1px solid rgba(255, 255, 255, 0.20);
      border-radius: var(--radius-full, 9999px);
      padding: 4px 12px;
    }
    .hero-section h1 {
      color: #ffffff;
      font-size: clamp(32px, 5vw, 52px);
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 20px;
    }
    .hero-p {
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.75;
      color: rgba(255, 255, 255, 0.88);
      max-width: 62ch;
      margin: 0 auto 32px;
    }
    .hero-actions { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; }
    .hero-phone-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      background: var(--color-accent);
      color: #ffffff;
      border-radius: var(--radius-brand);
      font-family: var(--font-body);
      font-size: 18px;
      font-weight: 700;
      text-decoration: none;
      box-shadow: var(--shadow-card);
      transition: transform 150ms ease, box-shadow 150ms ease;
    }
    .hero-phone-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-floating); }
    .hero-phone-btn:focus-visible { outline: 3px solid #ffffff; outline-offset: 3px; }
    .hero-phone-btn:active { transform: scale(0.98); }
    .hero-secondary-btn {
      display: inline-flex;
      align-items: center;
      padding: 14px 24px;
      border: 1.5px solid rgba(255, 255, 255, 0.5);
      border-radius: var(--radius-brand);
      color: #ffffff;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 15px;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease;
    }
    .hero-secondary-btn:hover { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.8); }
    .hero-secondary-btn:focus-visible { outline: 3px solid #ffffff; outline-offset: 3px; }

    /* ---------- 2. Services grid ---------- */
    .grid-services { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 32px; }
    .service-tile {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 24px;
      background: var(--surface-elevated);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      text-decoration: none;
      transition: border-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
    }
    .service-tile:hover { border-color: var(--color-primary); transform: translateY(-2px); box-shadow: var(--shadow-card); }
    .service-tile:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
    .service-tile-emoji { font-size: 28px; }
    .service-tile h3 { color: var(--surface-footer); margin: 0; }
    .service-tile p { font-size: 14px; color: var(--color-text-muted); margin: 0; }

    /* ---------- 3. GPG data ---------- */
    .gpg-data-grid {
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 40px;
      align-items: center;
    }
    .gpg-stat-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px;
      background: var(--surface-footer);
      border-radius: var(--radius-lg);
      text-align: center;
    }
    .gpg-stat-number {
      font-family: var(--font-heading);
      font-size: 48px;
      color: #ffffff;
      line-height: 1;
    }
    .gpg-stat-label {
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 600;
      color: var(--color-accent-light, var(--color-accent));
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 8px;
    }
    @media (max-width: 720px) {
      .gpg-data-grid { grid-template-columns: 1fr; }
    }

    /* ---------- 4 & 5. Alternating image-text sections ---------- */
    .service-section-wrapper { max-width: 1000px; margin: 0 auto; }
    .service-section-title {
      font-family: var(--font-heading);
      font-size: clamp(24px, 3.5vw, 38px);
      letter-spacing: -0.02em;
      color: var(--surface-footer);
      margin-bottom: 28px;
      line-height: 1.2;
      width: 100%;
    }
    .service-section-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
    }
    .service-section-text { order: 1; }
    .service-section-media { order: 2; }
    .service-section-grid-reverse .service-section-text { order: 2; }
    .service-section-grid-reverse .service-section-media { order: 1; }
    .service-section-media img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: var(--radius-lg);
    }
    .service-learn-more {
      display: inline-block;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 13px;
      color: var(--color-accent);
      text-decoration: none;
      margin-top: 12px;
    }
    .service-learn-more:hover { text-decoration: underline; }
    .service-learn-more:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
    @media (max-width: 860px) {
      .service-section-title { font-size: clamp(20px, 5vw, 28px); margin-bottom: 20px; }
      .service-section-grid { grid-template-columns: 1fr; gap: 24px; }
      .service-section-grid .service-section-text,
      .service-section-grid .service-section-media,
      .service-section-grid-reverse .service-section-text,
      .service-section-grid-reverse .service-section-media {
        order: initial;
      }
    }

    /* ---------- 6. CityMap dev-only placeholder ---------- */
    .map-placeholder {
      max-width: 1000px;
      margin: 0 auto;
      padding: 48px 24px;
      background: repeating-linear-gradient(
        45deg,
        var(--color-primary-light),
        var(--color-primary-light) 10px,
        var(--surface-elevated) 10px,
        var(--surface-elevated) 20px
      );
      border: 2px dashed var(--color-primary);
      border-radius: var(--radius-lg);
      text-align: center;
      font-family: var(--font-body);
      font-weight: 600;
      color: var(--surface-footer);
    }

    /* ---------- 7. Service areas (only rendered when serviceAreas is non-empty) ---------- */
    .homepage-service-areas { padding: 72px 24px; background: var(--surface-base); }
    .homepage-service-areas-inner { max-width: 960px; margin: 0 auto; text-align: center; }
    .homepage-service-areas h2 {
      font-family: var(--font-heading);
      font-size: clamp(24px, 3.5vw, 38px);
      letter-spacing: -0.02em;
      color: var(--surface-footer);
      margin-bottom: 12px;
    }
    .homepage-service-areas p {
      font-family: var(--font-body);
      font-size: 16px;
      color: var(--color-text-muted);
      margin-bottom: 32px;
    }
    .homepage-sa-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 16px;
    }
    .homepage-sa-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 20px 24px;
      background: var(--color-surface);
      border: 1.5px solid var(--color-border);
      border-radius: var(--radius-lg);
      text-decoration: none;
      transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
    }
    .homepage-sa-card:hover { border-color: var(--color-primary); transform: translateY(-3px); box-shadow: var(--shadow-card); }
    .homepage-sa-card:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
    .sa-card-city { font-family: var(--font-heading); font-size: 18px; color: var(--surface-footer); }
    .sa-card-detail { font-family: var(--font-body); font-size: 12px; color: var(--color-text-muted); }

    /* ---------- 8. Why Choose Us — bullet list, no cards ---------- */
    .why-choose-us { max-width: 760px; }
    .why-choose-us h2 { text-align: center; margin-bottom: 24px; }
    .why-choose-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .why-choose-list li {
      position: relative;
      padding-left: 28px;
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.6;
      color: var(--color-text-muted);
    }
    .why-choose-list li::before {
      content: '✓';
      position: absolute;
      left: 0;
      top: 0;
      color: var(--color-primary);
      font-weight: 700;
    }

    /* ---------- 9. FAQ accordion ---------- */
    .homepage-faq-section { padding: 72px 24px; background: var(--surface-elevated); }
    .homepage-faq-inner { max-width: 860px; margin: 0 auto; }
    .homepage-faq-header { text-align: center; margin-bottom: 40px; }
    .homepage-faq-header h2 {
      font-family: var(--font-heading);
      font-size: clamp(24px, 3.5vw, 38px);
      letter-spacing: -0.02em;
      color: var(--surface-footer);
      margin-bottom: 12px;
    }
    .homepage-faq-header p {
      font-family: var(--font-body);
      font-size: 16px;
      color: var(--color-text-muted);
      line-height: 1.6;
    }
    .homepage-faq-list {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-bottom: 28px;
    }
    .faq-item { border-bottom: 1px solid var(--color-border); }
    .faq-item:last-child { border-bottom: none; }
    .faq-item summary {
      padding: 20px 24px;
      font-family: var(--font-heading);
      font-size: 18px;
      color: var(--surface-footer);
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      user-select: none;
      transition: background-color 150ms ease;
    }
    .faq-item summary:hover { background: #ffffff; }
    .faq-item summary:focus-visible { outline: 3px solid var(--color-primary); outline-offset: -3px; }
    .faq-item summary::after {
      content: '+';
      font-family: var(--font-body);
      font-size: 22px;
      color: var(--color-primary);
      font-weight: 300;
      flex-shrink: 0;
      line-height: 1;
    }
    .faq-item[open] summary::after { content: '\2212'; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::marker { display: none; }
    .faq-answer {
      padding: 4px 24px 22px;
      font-family: var(--font-body);
      font-size: 15px;
      color: var(--color-text-muted);
      line-height: 1.75;
    }
    .faq-footer-link { text-align: center; }
    .faq-footer-link a {
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 600;
      color: var(--color-accent);
      text-decoration: none;
      transition: color 150ms ease;
    }
    .faq-footer-link a:hover { color: var(--color-primary); text-decoration: underline; }
    .faq-footer-link a:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }

    /* ---------- 10. Slim CTA bar ---------- */
    .homepage-cta-bar { background: var(--surface-footer); padding: 28px 24px; }
    .homepage-cta-bar-inner {
      max-width: 860px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .homepage-cta-bar-inner p {
      font-family: var(--font-body);
      font-size: 15px;
      color: rgba(255, 255, 255, 0.80);
      line-height: 1.6;
      flex: 1;
      min-width: 200px;
      margin: 0;
    }
    .cta-bar-btn {
      display: inline-block;
      padding: 12px 24px;
      background: var(--color-accent);
      color: #ffffff;
      border-radius: var(--radius-brand);
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
